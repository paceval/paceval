{
  "name": "paceval | Versioned measurement calibration",
  "nodes": [
    {
      "id": "start",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        180,
        260
      ],
      "parameters": {}
    },
    {
      "id": "inputs",
      "name": "Prepare Approved Inputs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        420,
        260
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "return [{json:{\"model\":\"calibration\",\"version\":\"1.0\",\"rows\":[[20,1,0.01,0.0001,0.5,10],[40,1,0.01,0.0001,0.5,0]]}}];"
      }
    },
    {
      "id": "request",
      "name": "Local paceval REST",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        680,
        260
      ],
      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:8787/api/v1/evaluate",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {
          "timeout": 30000
        }
      }
    },
    {
      "id": "decide",
      "name": "Calibrated Measurements",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        940,
        260
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "\nreturn $json.results.map((temperature,index)=>({json:{index,temperature,model:$json.model,version:$json.version}}));\n"
      }
    }
  ],
  "connections": {
    "Manual Trigger": {
      "main": [
        [
          {
            "node": "Prepare Approved Inputs",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Prepare Approved Inputs": {
      "main": [
        [
          {
            "node": "Local paceval REST",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Local paceval REST": {
      "main": [
        [
          {
            "node": "Calibrated Measurements",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "active": false,
  "pinData": {},
  "tags": []
}
