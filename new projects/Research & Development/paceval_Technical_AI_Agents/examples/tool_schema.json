      },
      "model_id": {
        "type": "string"
      },
      "expression": {
        "type": "string"
      },
      "output_unit": {
        "type": "string"
      },
      "inputs": {
        "type": "array",
        "minItems": 6,
        "maxItems": 6,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "unit"
          ],
          "properties": {
            "value": {
              "type": [
                "number",
                "null"
              ]
            },
            "unit": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
